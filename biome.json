{
  "$schema": "https://biomejs.dev/schemas/2.4.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/.turbo",
      "!**/.expo",
      "!**/dist",
      "!**/coverage",
      "!**/.pnpm-store",
      "!**/pnpm-lock.yaml",
      "!**/next-env.d.ts",
      "!apps/mobile/global.css",
      "!packages/uim/global.css",
      "!apps/auth/src/kc.gen.tsx",
      "!apps/auth/src/account",
      "!apps/auth/src/admin",
      "!apps/auth/src/shared",
      "!apps/notification",
      "!apps/server/notification-*"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "es5",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true,
      "quoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "warn"
      },
      "nursery": {
        "useSortedClasses": {
          "level": "warn",
          "options": {
            "attributes": ["className"],
            "functions": ["cn", "cva", "clsx", "tw"]
          }
        }
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/mobile/**", "packages/uim/**"],
      "linter": {
        "rules": {
          "nursery": {
            "useSortedClasses": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/ui/src/components/**",
        "packages/ui/src/blocks/**"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useFocusableInteractive": "off",
            "useKeyWithClickEvents": "off",
            "useAriaPropsForRole": "off",
            "useValidAnchor": "off",
            "noStaticElementInteractions": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noDocumentCookie": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/auth/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noBannedTypes": "off",
            "noUselessTypeConstraint": "off",
            "noUselessFragments": "off"
          },
          "a11y": {
            "useHtmlLang": "off",
            "useValidAriaValues": "off",
            "useValidAnchor": "off",
            "useIframeTitle": "off",
            "useButtonType": "off",
            "useAriaPropsSupportedByRole": "off",
            "noLabelWithoutControl": "off",
            "noPositiveTabindex": "off",
            "noAutofocus": "off",
            "useAltText": "off",
            "noSvgWithoutTitle": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "useJsxKeyInIterable": "off"
          },
          "suspicious": {
            "noEmptyBlockStatements": "off",
            "noExplicitAny": "off",
            "noArrayIndexKey": "off",
            "noShadowRestrictedNames": "off",
            "noConfusingLabels": "off",
            "noTemplateCurlyInString": "off",
            "noTsIgnore": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    }
  ]
}
