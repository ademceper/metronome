{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["biome.json", "lefthook.yml"]
    },
    "apps/web-user": {
      "project": ["**/*.{ts,tsx}"],
      "next": true,
      "ignoreDependencies": ["@tailwindcss/postcss", "@phosphor-icons/react"]
    },
    "apps/web-admin": {
      "project": ["**/*.{ts,tsx}"],
      "next": true,
      "ignoreDependencies": ["@tailwindcss/postcss", "@phosphor-icons/react"]
    },
    "apps/keycloakify-starter": {
      "entry": [
        "src/kc.gen.tsx",
        "src/login/KcPageStory.tsx",
        "src/login/i18n.ts",
        "src/login/KcContext.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "vite": true,
      "storybook": true
    },
    "packages/ui": {
      "entry": ["src/components/*.tsx", "src/lib/*.ts", "src/styles/*.css"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@tailwindcss/postcss", "@turbo/gen"]
    },
    "packages/ts-cfg": {
      "entry": ["*.json"],
      "ignoreDependencies": ["next"]
    }
  }
}
