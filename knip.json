{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignore": ["infrastructure/**"],
  "ignoreBinaries": ["sleep"],
  "ignoreWorkspaces": [
    "apps/server/*",
    "apps/mobile",
    "apps/notification",
    "packages/application-generic",
    "packages/automation",
    "packages/dal",
    "packages/internal-sdk",
    "packages/maily-*",
    "packages/notifications",
    "packages/testing",
    "packages/shared",
    "packages/framework",
    "packages/stateless",
    "packages/providers",
    "packages/js",
    "packages/react",
    "packages/react-native",
    "packages/nextjs",
    "packages/novu",
    "packages/novu-tsconfig",
    "packages/add-inbox",
    "packages/agent-toolkit",
    "packages/chat-adapter-email",
    "packages/api"
  ],
  "workspaces": {
    ".": {
      "entry": ["biome.json", "lefthook.yml"]
    },
    "apps/user": {
      "project": ["**/*.{ts,tsx}"],
      "next": true,
      "ignoreDependencies": ["@tailwindcss/postcss", "@phosphor-icons/react"]
    },
    "apps/admin": {
      "project": ["src/**/*.{ts,tsx}"],
      "vite": true,
      "ignoreDependencies": ["tailwindcss", "@phosphor-icons/react"]
    },
    "apps/auth": {
      "entry": [
        "src/kc.gen.tsx",
        "src/account/KcPage.tsx",
        "src/account/KcContext.ts",
        "src/admin/KcPage.tsx",
        "src/admin/KcContext.ts",
        "src/login/KcPageStory.tsx",
        "src/login/i18n.ts",
        "src/login/KcContext.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "vite": true,
      "storybook": true,
      "ignore": ["src/account/**", "src/admin/**", "src/shared/**"],
      "ignoreDependencies": ["tailwindcss", "postcss", "@tailwindcss/postcss"]
    },
    "packages/ui": {
      "entry": ["src/components/*.tsx", "src/lib/*.ts", "src/styles/*.css"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@tailwindcss/postcss", "@turbo/gen"]
    },
    "packages/ts-cfg": {
      "entry": ["*.json"],
      "ignoreDependencies": ["next"]
    },
    "packages/uim": {
      "entry": ["src/components/ui/*.tsx", "src/lib/*.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@rn-primitives/types"]
    },
    "packages/auth": {
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
