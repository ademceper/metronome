{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignore": ["infrastructure/**"],
  "ignoreBinaries": ["sleep", "go"],
  "ignoreWorkspaces": ["apps/server/*"],
  "workspaces": {
    ".": {
      "entry": ["biome.json", "lefthook.yml"]
    },
    "apps/user": {
      "project": ["**/*.{ts,tsx}"],
      "next": true,
      "ignoreDependencies": ["@tailwindcss/postcss", "@phosphor-icons/react"]
    },
    "apps/admin": {
      "project": ["src/**/*.{ts,tsx}"],
      "vite": true,
      "ignoreDependencies": ["tailwindcss", "@phosphor-icons/react"]
    },
    "apps/auth": {
      "entry": [
        "src/kc.gen.tsx",
        "src/login/KcPageStory.tsx",
        "src/login/i18n.ts",
        "src/login/KcContext.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "vite": true,
      "storybook": true,
      "ignoreDependencies": ["tailwindcss", "postcss", "@tailwindcss/postcss"]
    },
    "packages/ui": {
      "entry": ["src/components/*.tsx", "src/lib/*.ts", "src/styles/*.css"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@tailwindcss/postcss", "@turbo/gen"]
    },
    "packages/ts-cfg": {
      "entry": ["*.json"],
      "ignoreDependencies": ["next"]
    }
  }
}
