{
  "name": "auth",
  "version": "0.0.0",
  "description": "Keycloakify-based auth theme for metronome",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "keycloakify start-keycloak --keycloak-version 26",
    "dev:vite": "vite",
    "build": "tsc && vite build",
    "build-keycloak-theme": "pnpm run build && keycloakify build",
    "storybook": "storybook dev -p 6006",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "keycloakify": "^11.15.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@metronome/ts-cfg": "workspace:*",
    "@storybook/react": "^8.1.10",
    "@storybook/react-vite": "^8.1.10",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.2.1",
    "storybook": "^8.1.10",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  },
  "engines": {
    "node": "^18.0.0 || >=20.0.0"
  }
}
