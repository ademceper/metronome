{
  "name": "@novu/framework",
  "version": "2.10.1-alpha.7",
  "description": "The Code-First Notifications Workflow SDK.",
  "main": "./dist/cjs/index.cjs",
  "types": "./dist/cjs/index.d.cts",
  "module": "./dist/esm/index.js",
  "publishConfig": {
    "access": "public"
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/novuhq/novu.git"
  },
  "files": [
    "dist",
    "express",
    "h3",
    "internal",
    "lambda",
    "nest",
    "next",
    "nuxt",
    "remix",
    "step-resolver",
    "sveltekit",
    "jsx-runtime",
    "jsx-dev-runtime",
    "validators",
    "README.md"
  ],
  "scripts": {
    "test": "vitest --typecheck",
    "test:watch": "vitest --typecheck --watch",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "build": "NODE_ENV=production tsup",
    "debug": "NODE_ENV=production tsup --config tsup-debug.config.ts",
    "build:watch": "tsup --watch",
    "postbuild": "pnpm run check:exports && pnpm check:circulars",
    "check:exports": "attw --pack .",
    "check:circulars": "madge --circular --extensions ts ./src",
    "bump:prerelease": "npm version prerelease --preid=alpha & PID=$!; (sleep 1 && kill -9 $PID) & wait $PID",
    "release:alpha": "pnpm bump:prerelease || pnpm build && npm publish",
    "devtool": "tsx ./scripts/devtool.ts"
  },
  "keywords": [
    "novu",
    "code-first",
    "workflows",
    "durable",
    "sdk",
    "notifications",
    "email",
    "sms",
    "push",
    "webhooks",
    "next",
    "nuxt",
    "h3",
    "express"
  ],
  "author": "Novu Team <engineering@novu.co>",
  "license": "ISC",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs",
      "types": "./dist/cjs/index.d.cts"
    },
    "./internal": {
      "import": "./dist/esm/internal/index.js",
      "require": "./dist/cjs/internal/index.cjs",
      "types": "./dist/cjs/internal/index.d.cts"
    },
    "./nest": {
      "import": "./dist/esm/servers/nest.js",
      "require": "./dist/cjs/servers/nest.cjs",
      "types": "./dist/cjs/servers/nest.d.cts"
    },
    "./express": {
      "import": "./dist/esm/servers/express.js",
      "require": "./dist/cjs/servers/express.cjs",
      "types": "./dist/cjs/servers/express.d.cts"
    },
    "./h3": {
      "import": "./dist/esm/servers/h3.js",
      "require": "./dist/cjs/servers/h3.cjs",
      "types": "./dist/cjs/servers/h3.d.cts"
    },
    "./lambda": {
      "import": "./dist/esm/servers/lambda.js",
      "require": "./dist/cjs/servers/lambda.cjs",
      "types": "./dist/cjs/servers/lambda.d.cts"
    },
    "./next": {
      "import": "./dist/esm/servers/next.js",
      "require": "./dist/cjs/servers/next.cjs",
      "types": "./dist/cjs/servers/next.d.cts"
    },
    "./nuxt": {
      "import": "./dist/esm/servers/nuxt.js",
      "require": "./dist/cjs/servers/nuxt.cjs",
      "types": "./dist/cjs/servers/nuxt.d.cts"
    },
    "./remix": {
      "import": "./dist/esm/servers/remix.js",
      "require": "./dist/cjs/servers/remix.cjs",
      "types": "./dist/cjs/servers/remix.d.cts"
    },
    "./sveltekit": {
      "import": "./dist/esm/servers/sveltekit.js",
      "require": "./dist/cjs/servers/sveltekit.cjs",
      "types": "./dist/cjs/servers/sveltekit.d.cts"
    },
    "./step-resolver": {
      "import": "./dist/esm/step-resolver.js",
      "require": "./dist/cjs/step-resolver.cjs",
      "types": "./dist/cjs/step-resolver.d.cts"
    },
    "./validators": {
      "import": "./dist/esm/validators.js",
      "require": "./dist/cjs/validators.cjs",
      "types": "./dist/cjs/validators.d.cts"
    },
    "./jsx-runtime": {
      "import": "./dist/esm/jsx-runtime.js",
      "require": "./dist/cjs/jsx-runtime.cjs",
      "types": "./dist/cjs/jsx-runtime.d.cts"
    },
    "./jsx-dev-runtime": {
      "import": "./dist/esm/jsx-dev-runtime.js",
      "require": "./dist/cjs/jsx-dev-runtime.cjs",
      "types": "./dist/cjs/jsx-dev-runtime.d.cts"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0",
    "@sveltejs/kit": ">=1.27.3",
    "@vercel/node": ">=2.15.9",
    "aws-lambda": ">=1.0.7",
    "express": ">=4.19.2",
    "h3": ">=1.8.1",
    "next": ">=12.0.0",
    "zod": ">=3.0.0",
    "zod-to-json-schema": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@sveltejs/kit": {
      "optional": true
    },
    "@vercel/node": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "h3": {
      "optional": true
    },
    "aws-lambda": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "zod-to-json-schema": {
      "optional": true
    }
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "11.6.4",
    "@arethetypeswrong/cli": "^0.17.4",
    "@nestjs/common": "10.4.18",
    "@sveltejs/kit": "^1.27.3",
    "@types/aws-lambda": "^8.10.141",
    "@types/express": "^4.17.13",
    "@types/node": "^22.0.0",
    "@types/pluralize": "^0.0.33",
    "@types/sanitize-html": "2.11.0",
    "@vercel/node": "^2.15.9",
    "aws-lambda": "^1.0.7",
    "express": "^4.19.2",
    "h3": "^1.11.1",
    "madge": "^8.0.0",
    "next": "^16.2.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.0.2",
    "tsx": "4.16.2",
    "typescript": "5.6.2",
    "vitest": "^1.2.1",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.3"
  },
  "dependencies": {
    "chat": "^4.25.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^2.1.1",
    "better-ajv-errors": "^1.2.0",
    "chalk": "^4.1.2",
    "cross-fetch": "^4.0.0",
    "json-schema-to-ts": "^3.0.0",
    "jsonrepair": "^3.13.1",
    "liquidjs": "^10.25.7",
    "pluralize": "^8.0.0",
    "sanitize-html": "^2.13.0"
  },
  "nx": {
    "tags": [
      "type:package"
    ]
  }
}