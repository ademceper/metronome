{
  "name": "@novu/shared",
  "version": "2.6.6",
  "description": "",
  "scripts": {
    "start": "npm run start:dev",
    "afterinstall": "pnpm build",
    "prebuild": "rimraf dist",
    "build": "npm run build:cjs && npm run build:esm",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.json",
    "build:watch": "cross-env node_modules/.bin/tsc -p tsconfig.json -w --preserveWatchOutput",
    "postbuild": "npm run check:circulars",
    "start:dev": "pnpm build:watch",
    "precommit": "lint-staged",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest",
    "watch:test": "pnpm test --watch",
    "check:circulars": "madge --circular --extensions ts ./src"
  },
  "author": "",
  "license": "ISC",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/cjs/index.d.ts"
    },
    "./*": {
      "import": "./dist/esm/*.js",
      "require": "./dist/cjs/*.js",
      "types": "./dist/cjs/*.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "!**/*.spec.*",
    "!**/*.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "lru-cache": "^11.2.4"
  },
  "devDependencies": {
    "madge": "^8.0.0",
    "rimraf": "^3.0.2",
    "typescript": "5.6.2",
    "vitest": "^2.1.9"
  },
  "nx": {
    "tags": [
      "type:package"
    ]
  }
}