{
  "name": "metronome",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=!./apps/notification --filter=!./apps/server/notification-* --filter=!./lib/*",
    "dev:notification": "turbo dev --filter=./apps/notification --filter=./apps/server/notification-* --filter=./lib/*",
    "dev:all": "turbo dev",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "turbo typecheck",
    "knip": "knip",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@metronome/ts-cfg": "workspace:*",
    "knip": "^6.11.0",
    "lefthook": "^2.1.6",
    "turbo": "^2.8.17",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  }
}
